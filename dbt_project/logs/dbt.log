from "ops"."staging"."stg_patients" p
left join "ops"."staging"."stg_intake" i
    on p.patient_id = i.patient_id
left join "ops"."staging"."stg_experiment_assignments" x
    on p.patient_id = x.patient_id
    );
    
  
